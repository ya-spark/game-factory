import 'dart:typed_data';

import 'package:game_block_puzzle/block_puzzle.dart';

import 'package:__APP__/core/analytics/analytics_service.dart';
import 'package:__APP__/core/services.dart' as core;
import 'package:__APP__/core/share/share_service.dart';
import 'package:__APP__/host/block_puzzle/ad_service.dart';
import 'package:__APP__/host/block_puzzle/profile_store.dart';

/// The few config values the BlockPuzzle screens read.
class HostConfig implements BlockPuzzleConfig {
  const HostConfig({required this.displayName, required this.retention});
  @override
  final String displayName;
  final HostRetention retention;
  @override
  final String leaderboardHighScore = '';
  @override
  bool get streaksEnabled => retention.streaks;
}

class HostRetention {
  const HostRetention({required this.streaks});
  final bool streaks;
}

/// Block Puzzle scores and achievements are not sent to a leaderboard from the hub.
class HostLeaderboard implements BlockPuzzleLeaderboard {
  const HostLeaderboard();
  @override
  Future<void> submitScore(String leaderboardId, int score) async {}
  @override
  Future<void> unlockAchievement(String achievementId) async {}
}

/// What the copied Block Puzzle screens call "Services": a small adapter over the hub's own
/// services. Coins, Remove Ads, ad pacing, share and analytics are the hub's.
class Services implements BlockPuzzleServices {
  Services({required this.hub, required this.profile, String? displayName})
    : config = HostConfig(
        displayName: displayName ?? 'Block Puzzle',
        retention: HostRetention(streaks: hub.config.retention.streaks),
      ),
      ads = HostAds(hub.ads);

  /// The hub's services.
  final core.Services hub;
  @override
  final ProfileStore profile;
  @override
  final HostConfig config;
  @override
  final HostAds ads;
  @override
  final HostLeaderboard leaderboard = const HostLeaderboard();

  @override
  BlockPuzzleAnalytics get analytics => _HubAnalytics(hub.analytics);
  @override
  BlockPuzzleShare get share => _HubShare(hub.share);

  /// True while the game screen is on the navigator.
  @override
  bool inRun = false;
}

class _HubAnalytics implements BlockPuzzleAnalytics {
  _HubAnalytics(this._a);
  final AnalyticsService _a;
  @override
  void logEvent(String name, [Map<String, Object?> params = const {}]) =>
      _a.logEvent(name, params);
}

class _HubShare implements BlockPuzzleShare {
  _HubShare(this._s);
  final ShareService _s;
  @override
  Future<void> shareScore({required int score, Uint8List? image}) =>
      _s.shareScore(score: score, image: image);
}
